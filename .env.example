# Copie este arquivo para .env e coloque sua chave da apifootball.com
# IMPORTANTE: nunca suba o arquivo .env para o GitHub (ja esta no .gitignore)
APIFOOTBALL_KEY=coloque_sua_chave_aqui

# Fuso horario usado nas datas/horarios retornados (opcional)
APIFOOTBALL_TIMEZONE=America/Sao_Paulo

# (Opcional) Webhook do Discord para enviar os picks automaticamente.
# Discord -> Config do canal -> Integracoes -> Webhooks -> Novo webhook -> Copiar URL
DISCORD_WEBHOOK_URL=
